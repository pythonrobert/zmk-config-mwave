#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/advertising_mode.h>
#include <behaviors/advertising_mode.dtsi>
#include <behaviors/stp_indicators.dtsi>
#include "studio-macros.dtsi"

/*
 * The mWave firmware reserves 12 x 32 virtual positions for Studio macros.
 * These helpers keep every active layer aligned with the board transform.
 */
#define VIRTUAL_TRANS_32 \
    &trans &trans &trans &trans &trans &trans &trans &trans \
    &trans &trans &trans &trans &trans &trans &trans &trans \
    &trans &trans &trans &trans &trans &trans &trans &trans \
    &trans &trans &trans &trans &trans &trans &trans &trans

#define VIRTUAL_NONE_32 \
    &none &none &none &none &none &none &none &none \
    &none &none &none &none &none &none &none &none \
    &none &none &none &none &none &none &none &none \
    &none &none &none &none &none &none &none &none

#define VIRTUAL_TRANS_384 \
    VIRTUAL_TRANS_32 VIRTUAL_TRANS_32 VIRTUAL_TRANS_32 VIRTUAL_TRANS_32 \
    VIRTUAL_TRANS_32 VIRTUAL_TRANS_32 VIRTUAL_TRANS_32 VIRTUAL_TRANS_32 \
    VIRTUAL_TRANS_32 VIRTUAL_TRANS_32 VIRTUAL_TRANS_32 VIRTUAL_TRANS_32

#define VIRTUAL_NONE_384 \
    VIRTUAL_NONE_32 VIRTUAL_NONE_32 VIRTUAL_NONE_32 VIRTUAL_NONE_32 \
    VIRTUAL_NONE_32 VIRTUAL_NONE_32 VIRTUAL_NONE_32 VIRTUAL_NONE_32 \
    VIRTUAL_NONE_32 VIRTUAL_NONE_32 VIRTUAL_NONE_32 VIRTUAL_NONE_32

/ {
    #include "mwave_prim.dtsi"

    behaviors {
        spc_ctl: space_control {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
            display-name = "Space/Ctrl";
        };
    };

    combos {
        compatible = "zmk,combos";

        df_keypad_toggle {
            bindings = <&tog 1>;
            key-positions = <49 50>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        er_mute {
            bindings = <&kp C_MUTE>;
            key-positions = <34 35>;
            layers = <0>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp F1    &kp F2       &kp F3      &kp F4     &kp F5       &kp F6       &kp F7      &kp F8     &kp F9     &kp F10    &kp F11    &kp F12    &kp HOME   &kp END  &kp INSERT  &to 1
&kp GRAVE  &kp N1    &kp N2       &kp N3      &kp N4     &kp N5       &kp N6       &kp N7      &kp N8     &kp N9     &kp N0     &kp MINUS  &kp EQUAL  &kp BSPC
&kp TAB    &kp Q     &kp W        &kp E       &kp R      &kp T        &kp Y        &kp U       &kp I      &kp O      &kp P      &kp LBKT   &kp RBKT   &kp BSLH   &kp DEL
&mt LSHFT ESC &kp A  &lt 3 S      &lt 1 D     &lt 2 F    &lt 4 G      &kp H        &lt 2 J     &kp K      &kp L      &kp SEMI   &kp SQT    &kp RET    &kp PG_UP
&kp LSHFT  &kp Z     &kp X        &kp C       &kp V      &lt 5 B      &kp N        &kp M       &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT  &kp UP     &kp PG_DN
&kp LCTRL  &kp LGUI  &kp LALT     &spc_ctl LCTRL SPACE   &kp SPACE    &kp RALT     &kp K_CMENU  &kp RCTRL  &kp LEFT   &kp DOWN   &kp RIGHT  &none
VIRTUAL_NONE_384
            >;
        };

        raise {
            display-name = "Keypad";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans          &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &to 0
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp KP_NUMLOCK &trans  &kp FSLH &kp ASTRK  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp FSLH &kp N7         &kp N8  &kp N9   &kp ASTRK  &trans  &trans  &trans  &trans
&studio_unlock &trans  &trans  &trans  &trans  &trans   &kp MINUS      &kp N4  &kp N5   &kp N6    &kp PLUS  &kp COMMA  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp EQUAL &kp N1       &kp N2  &kp N3   &kp DOT    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp N0  &trans  &trans  &trans  &trans  &trans  &trans  &none
VIRTUAL_TRANS_384
            >;
        };

        extra1 {
            display-name = "NAV";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &trans  &trans  &kp UP   &kp F4  &kp F9  &kp PG_UP  &kp HOME  &kp UP  &kp END  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp F2  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp K_CMENU  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LBKT  &kp RBKT  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
VIRTUAL_TRANS_384
            >;
        };

        extra2 {
            display-name = "FN-KP";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp F7   &kp F8   &kp F9   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp F4   &kp F5   &kp F6   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp F1   &kp F2   &kp F3   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
VIRTUAL_TRANS_384
            >;
        };

        extra3 {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_UP  &mkp LCLK  &mmv MOVE_UP  &mkp RCLK  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
VIRTUAL_TRANS_384
            >;
        };

        extra4 {
            display-name = "Media";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_PP  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_NEXT  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
VIRTUAL_TRANS_384
            >;
        };

        extra5 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
